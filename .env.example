# Microsoft Graph (Azure AD app registration)
MSGRAPH_CLIENT_ID=
MSGRAPH_TENANT_ID=5c06fe0d-d83c-4e82-8f11-43b3e0b6acf0
MSGRAPH_SCOPES=Mail.Read Mail.ReadWrite

# Email backend: mock | graph
EMAIL_BACKEND=mock

# Ollama (local LLM)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
CLASSIFIER_MODE=rule
RESPONDER_MODE=rule

# Obsidian vault — defaults to ./vault in this repo
# OBSIDIAN_VAULT_PATH=/Users/you/Email_Agent/vault

# Auto-send: off | safe | full (MVP: always off)
AUTO_SEND_MODE=off

# Email Assistant Studio (web UI)
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8080

# Paths
DATA_DIR=data

# Set true to persist waiting-item closures to data/waiting_for.yaml
UPDATE_WAITING_YAML=false

# Email Settings — rule engine and poller (Phase 1+)
RULE_ENGINE_ENABLED=false
POLLER_INTERVAL_SECONDS=300
# QUEUE_DIR=data/queue
